# Build targets for the ICLR 2027 manuscript package (task 23.1;
# Requirement 20.1-20.4).
#
# `make submission`   -- anonymous build (default; author/affiliation
#                         macros stay commented out in main.tex, so
#                         Requirement 20.3's double-blind requirement is
#                         satisfied structurally rather than by convention).
# `make camera-ready` -- builds a *copy* of main.tex with \iclrfinalcopy
#                         uncommented (via sed, into a build-only temp
#                         file), never editing main.tex itself -- there is
#                         exactly one source of the paper's real content
#                         (see main.tex's own module-level comment).
# `make clean`         -- removes build artifacts (never generated/, which
#                          is scripts/run_paper.py's write target and is
#                          regenerated by that command, not by this
#                          Makefile).
#
# Uses `tectonic` (a self-contained, dependency-free LaTeX engine) rather
# than assuming a full TeX Live install is present -- this project's CI/
# dev environment has `tectonic` available where a traditional `pdflatex`
# + `bibtex` toolchain is not.

TECTONIC := tectonic
MAIN := main.tex
CAMERA_READY_TEX := .camera_ready_main.tex

.PHONY: submission camera-ready clean

submission: $(MAIN)
	$(TECTONIC) --keep-logs --keep-intermediates $(MAIN) 2>&1 | tee tectonic_submission.log

camera-ready:
	sed 's/^%\\iclrfinalcopy/\\iclrfinalcopy/' $(MAIN) > $(CAMERA_READY_TEX)
	$(TECTONIC) --keep-logs --keep-intermediates $(CAMERA_READY_TEX) 2>&1 | tee tectonic_camera_ready.log
	mv $(CAMERA_READY_TEX:.tex=.pdf) main_camera_ready.pdf 2>/dev/null || true

clean:
	rm -f build main.pdf $(CAMERA_READY_TEX) $(wildcard .camera_ready_main.*) main_camera_ready.pdf \
		tectonic_submission.log tectonic_camera_ready.log *.aux *.bbl *.blg *.log *.out
